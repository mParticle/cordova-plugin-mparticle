<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://cordova.apache.org/ns/plugins/1.0"
           id="@mparticle/cordova-rokt-kit"
           version="5.0.0">
    <name>MParticle Rokt Kit</name>
    <description>Adds support for Rokt to your Cordova project</description>
    <engines>
        <engine name="cordova" version=">=12.0.0" />
        <engine name="cordova-ios" version=">=8.0.0" />
    </engines>
    <platform name="android">
        <framework src="com.mparticle:android-rokt-kit:6.0.0"/>
    </platform>
    <!-- The iOS dependency is a Swift package: see Package.swift. -->
    <platform name="ios" package="swift" />
</plugin>
